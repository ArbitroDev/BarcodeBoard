<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BarcodeBoard.Core\BarcodeBoard.Core.csproj" />
    <ProjectReference Include="..\BarcodeBoard.ViewModels\BarcodeBoard.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <!-- Icône dessinée par tools/IconGen.cs (proposition K. Squircle) : exe, fenêtres et barre des tâches -->
  <ItemGroup>
    <Content Include="Assets\BarcodeBoard.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 et plus -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BarcodeBoard</RootNamespace>
    <AssemblyName>BarcodeBoard.WinUI</AssemblyName>
    <Product>Barcode Board</Product>
    <AssemblyTitle>Barcode Board</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BarcodeBoard.ico</ApplicationIcon>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <UseWinUI>true</UseWinUI>
    <!-- Application non empaquetée et autonome : ni MSIX, ni runtime du Windows App SDK à installer -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Main est dans Program.cs : une seule instance par session, fichiers transmis à celle déjà ouverte -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Publication : un seul .exe ; ses dépendances sont extraites dans un dossier temporaire au premier lancement -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
