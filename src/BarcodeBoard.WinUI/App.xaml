<Application x:Class="BarcodeBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Palettes des thèmes clair et sombre : exactement les mêmes clés dans les deux (vérifié par un test).
                 Aucune clé de palette ne reprend une clé de ce fichier hors palettes (une collision a déjà fait planter l'application). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBg" Color="#EDF0F5"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="Muted" Color="#5F5F5F"/>
                    <SolidColorBrush x:Key="Tertiary" Color="#9A9A9A"/>
                    <SolidColorBrush x:Key="Accent" Color="#005FB8"/>
                    <SolidColorBrush x:Key="AccentText" Color="#00468A"/>
                    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="OnAccentBorder" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="OnAccentHover" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="Line" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="Field" Color="#D1D1D1"/>
                    <SolidColorBrush x:Key="FieldBg" Color="#FDFDFD"/>
                    <SolidColorBrush x:Key="Hover" Color="#0D000000"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardDivider" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="CardBlurBorder" Color="#EDEDED"/>
                    <SolidColorBrush x:Key="RowSelectedBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="RowSelectedBorder" Color="#C9DBEE"/>
                    <SolidColorBrush x:Key="DashStroke" Color="#B5B5B5"/>
                    <SolidColorBrush x:Key="OverlayBg" Color="#E6FFFFFF"/>
                    <SolidColorBrush x:Key="OverlayBorder" Color="#DADADA"/>
                    <SolidColorBrush x:Key="FullBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToastBg" Color="#22282C"/>
                    <SolidColorBrush x:Key="ToastFg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ChromeLayer" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="SideLayer" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="ContentLayer" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="ChromeLayerMica" Color="#CCF9F9F9"/>
                    <SolidColorBrush x:Key="SideLayerMica" Color="#80F6F6F6"/>
                    <SolidColorBrush x:Key="ContentLayerMica" Color="#E6F9F9F9"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Muted" Color="#C5C5C5"/>
                    <SolidColorBrush x:Key="Tertiary" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
                    <SolidColorBrush x:Key="AccentText" Color="#99DDFF"/>
                    <SolidColorBrush x:Key="OnAccent" Color="#000000"/>
                    <SolidColorBrush x:Key="OnAccentBorder" Color="#80000000"/>
                    <SolidColorBrush x:Key="OnAccentHover" Color="#1F000000"/>
                    <SolidColorBrush x:Key="Line" Color="#383838"/>
                    <SolidColorBrush x:Key="Field" Color="#454545"/>
                    <SolidColorBrush x:Key="FieldBg" Color="#333333"/>
                    <SolidColorBrush x:Key="Hover" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="CardBg" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="CardDivider" Color="#363636"/>
                    <SolidColorBrush x:Key="CardBlurBorder" Color="#303030"/>
                    <SolidColorBrush x:Key="RowSelectedBg" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="RowSelectedBorder" Color="#2F4E6B"/>
                    <SolidColorBrush x:Key="DashStroke" Color="#5E5E5E"/>
                    <SolidColorBrush x:Key="OverlayBg" Color="#E61F1F1F"/>
                    <SolidColorBrush x:Key="OverlayBorder" Color="#4A4A4A"/>
                    <SolidColorBrush x:Key="FullBg" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="ToastBg" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="ToastFg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ChromeLayer" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="SideLayer" Color="#242424"/>
                    <SolidColorBrush x:Key="ContentLayer" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="ChromeLayerMica" Color="#B32B2B2B"/>
                    <SolidColorBrush x:Key="SideLayerMica" Color="#4D1C1C1C"/>
                    <SolidColorBrush x:Key="ContentLayerMica" Color="#D91C1C1C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

            <!-- Texte secondaire (états, libellés) -->
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource Muted}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Icône dessinée au trait, 16 × 16 (QR code, code-barres, liste, mode scan) -->
            <Style x:Key="IconPath" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stroke" Value="{ThemeResource TextBrush}"/>
                <Setter Property="StrokeThickness" Value="1.2"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="IconFillPath" TargetType="Path">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Fill" Value="{ThemeResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
