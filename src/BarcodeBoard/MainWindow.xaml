<Window x:Class="BarcodeBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BarcodeBoard"
        xmlns:controls="using:BarcodeBoard.Controls">

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown" CharacterReceived="Root_CharacterReceived">
        <Grid.RowDefinitions>
            <!-- Barre de titre : les onglets y sont, comme dans l'Explorateur -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Barre de titre et onglets ===================== -->
        <!-- Intégration de l'exemple officiel (galerie WinUI, TabView et arrachage) : la bande d'onglets dans la
             barre de titre, un en-tête et un pied vides. Le pied sert de zone de déplacement de la fenêtre
             (SetTitleBar) ; Windows y dessine ses boutons Réduire / Agrandir / Fermer. Le contenu de l'onglet
             actif est plus bas, un seul pour la fenêtre : TabView ne montre que sa bande. -->
        <TabView x:Name="Tabs" VerticalAlignment="Top" IsAddTabButtonVisible="True" CanTearOutTabs="True"
                 AddTabButtonClick="Tabs_AddTabButtonClick" SelectionChanged="Tabs_SelectionChanged"
                 TabCloseRequested="Tabs_TabCloseRequested" TabItemsChanged="Tabs_TabItemsChanged"
                 TabTearOutWindowRequested="Tabs_TabTearOutWindowRequested" TabTearOutRequested="Tabs_TabTearOutRequested"
                 ExternalTornOutTabsDropping="Tabs_ExternalTornOutTabsDropping" ExternalTornOutTabsDropped="Tabs_ExternalTornOutTabsDropped">
            <TabView.TabStripHeader>
                <Grid x:Name="ShellTitleBarInset" Background="Transparent"/>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="CustomDragRegion" Background="Transparent"/>
            </TabView.TabStripFooter>
        </TabView>

        <!-- ===================== Corps ===================== -->
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre d'outils : même fond que l'onglet actif, dans lequel elle se fond -->
            <Border x:Name="Toolbar" Background="{ThemeResource TabViewItemHeaderBackgroundSelected}" BorderBrush="{ThemeResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="ListToggle" IsChecked="{x:Bind ViewModel.SideOpen, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind local:Loc.ListTip}"
                                      Background="Transparent" BorderThickness="0">
                            <!-- Bascule discrète : coché, un léger fond, pas la couleur d'accent -->
                            <ToggleButton.Resources>
                                <ResourceDictionary>
                                    <!-- Par thème : résolues dans le thème de la fenêtre, et suivent son changement -->
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </ToggleButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="F0 M2,2.5 H14 V13.5 H2 Z M3.2,3.7 V12.3 H5.9 V3.7 Z M7.1,3.7 V12.3 H12.8 V3.7 Z"/>
                                <TextBlock Text="{x:Bind local:Loc.List}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Rectangle Width="1" Height="20" Fill="{ThemeResource Line}" Margin="4,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}" Click="Open_Click" ToolTipService.ToolTip="{x:Bind local:Loc.OpenTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock Text="{x:Bind local:Loc.Open}"/>
                            </StackPanel>
                        </Button>
                        <!-- Bouton partagé : Enregistrer, et sa flèche pour Enregistrer sous… -->
                        <SplitButton Click="Save_Click" ToolTipService.ToolTip="{x:Bind local:Loc.SaveTip}" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                <TextBlock Text="{x:Bind local:Loc.Save}"/>
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="{x:Bind local:Loc.SaveAs}" KeyboardAcceleratorTextOverride="{x:Bind local:Loc.SaveAsShortcut}" Click="SaveAs_Click"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <TextBlock Text="{x:Bind ViewModel.SelectedTab.FileStatus, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="12"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind local:Loc.CodeSize}" Style="{StaticResource MutedText}"/>
                        <Slider Width="130" VerticalAlignment="Center" Minimum="110" Maximum="280" SmallChange="10" LargeChange="20" StepFrequency="2"
                                IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.CodeSize, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind local:Loc.CodeSizeTip}"/>
                        <Rectangle Width="1" Height="20" Fill="{ThemeResource Line}"/>
                        <!-- Mode scan : bascule à la couleur d'accent quand il est actif -->
                        <ToggleButton IsChecked="{x:Bind ViewModel.ScanMode, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind local:Loc.ScanModeTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="M2,2 H6 V3.2 H3.2 V6 H2 Z M10,2 H14 V6 H12.8 V3.2 H10 Z M14,10 V14 H10 V12.8 H12.8 V10 Z M6,14 H2 V10 H3.2 V12.8 H6 Z M2,7.4 H14 V8.6 H2 Z"/>
                                <TextBlock Text="{x:Bind local:Loc.ScanMode}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Rectangle Width="1" Height="20" Fill="{ThemeResource Line}"/>
                    <!-- Paramètres (thème) -->
                    <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{x:Bind local:Loc.SettingsTip}">
                        <FontIcon Glyph="&#xE713;" FontSize="15"/>
                        <Button.Flyout>
                            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="SettingsFlyout_Opening">
                                <StackPanel Width="400">
                                    <TextBlock Text="{x:Bind local:Loc.Settings}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind local:Loc.AppTheme}" Style="{StaticResource MutedText}" Margin="0,4,0,10"/>
                                    <!-- Les vignettes montrent chaque thème tel qu'il est, quel que soit le thème actif :
                                         leurs couleurs fixes sont voulues et ne passent pas par les palettes. -->
                                    <GridView x:Name="ThemeTiles" SelectionMode="Single" SelectionChanged="ThemeTiles_SelectionChanged">
                                        <GridViewItem>
                                            <StackPanel Width="112" Margin="4">
                                                <Grid Height="60" CornerRadius="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#F3F3F3"/>
                                                    <Border Grid.Column="1" Background="#202020"/>
                                                    <Rectangle Width="30" Height="6" RadiusX="3" RadiusY="3" Fill="#005FB8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                                    <Rectangle Grid.Column="1" Fill="#2B2B2B" RadiusX="4" RadiusY="4" Margin="0,20,8,8"/>
                                                    <Rectangle Fill="White" RadiusX="4" RadiusY="4" Margin="8,20,0,8"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind local:Loc.ThemeSystem}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12.5"/>
                                            </StackPanel>
                                        </GridViewItem>
                                        <GridViewItem>
                                            <StackPanel Width="112" Margin="4">
                                                <Grid Height="60" CornerRadius="5" Background="#F3F3F3">
                                                    <Rectangle Width="30" Height="6" RadiusX="3" RadiusY="3" Fill="#005FB8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                                    <Rectangle Fill="White" RadiusX="4" RadiusY="4" Margin="8,20,8,8"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind local:Loc.ThemeLight}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12.5"/>
                                            </StackPanel>
                                        </GridViewItem>
                                        <GridViewItem>
                                            <StackPanel Width="112" Margin="4">
                                                <Grid Height="60" CornerRadius="5" Background="#202020">
                                                    <Rectangle Width="30" Height="6" RadiusX="3" RadiusY="3" Fill="#4CC2FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                                    <Rectangle Fill="#2B2B2B" RadiusX="4" RadiusY="4" Margin="8,20,8,8"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind local:Loc.ThemeDark}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12.5"/>
                                            </StackPanel>
                                        </GridViewItem>
                                    </GridView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideColumn" Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== Liste latérale ===================== -->
                <!-- Désactivée en mode scan : le clavier n'y modifie rien -->
                <ContentControl x:Name="SidePanel" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.SideOpen, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.NotScanMode, Mode=OneWay}">
                    <Grid x:Name="SideLayer" BorderBrush="{ThemeResource Line}" BorderThickness="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.SelectedTab.CountLabel, Mode=OneWay}" Style="{StaticResource MutedText}" Margin="14,12,14,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,2,10,14">
                            <StackPanel>
                                <ItemsControl x:Name="SideList" ItemsSource="{x:Bind ViewModel.SelectedTab.Codes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:CodeItemViewModel">
                                            <Grid Margin="0,1" Background="Transparent" PointerPressed="Row_PointerPressed">
                                                <Border CornerRadius="6" BorderThickness="1" Background="{ThemeResource RowSelectedBg}" BorderBrush="{ThemeResource RowSelectedBorder}"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                                <Grid Padding="0,4,4,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Poignée : glisser pour déplacer le code -->
                                                    <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind local:Loc.DragToMove}" controls:PointerCursor.Shape="SizeAll"
                                                            PointerPressed="Grip_PointerPressed" PointerMoved="Drag_PointerMoved" PointerReleased="Drag_PointerReleased"
                                                            PointerCaptureLost="Drag_PointerCaptureLost">
                                                        <PathIcon Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource Tertiary}" Data="M5.4,3.4 h1.2 v1.2 h-1.2 Z M9.4,3.4 h1.2 v1.2 h-1.2 Z M5.4,7.4 h1.2 v1.2 h-1.2 Z M9.4,7.4 h1.2 v1.2 h-1.2 Z M5.4,11.4 h1.2 v1.2 h-1.2 Z M9.4,11.4 h1.2 v1.2 h-1.2 Z"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <ToggleButton IsChecked="{x:Bind IsQr, Mode=OneWay}" Click="RowQr_Click" Padding="6,5" CornerRadius="4,0,0,4"
                                                                      ToolTipService.ToolTip="{x:Bind local:Loc.QrCode}">
                                                            <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="F0 M2,2 H7 V7 H2 Z M3.2,3.2 V5.8 H5.8 V3.2 Z M9,2 H14 V7 H9 Z M10.2,3.2 V5.8 H12.8 V3.2 Z M2,9 H7 V14 H2 Z M3.2,10.2 V12.8 H5.8 V10.2 Z M9,9 H11 V11 H9 Z M12,12 H14 V14 H12 Z M9,12.6 H10.4 V14 H9 Z M12.6,9 H14 V10.4 H12.6 Z"/>
                                                        </ToggleButton>
                                                        <ToggleButton IsChecked="{x:Bind IsCode128, Mode=OneWay}" Click="RowCode128_Click" Padding="6,5" CornerRadius="0,4,4,0"
                                                                      ToolTipService.ToolTip="{x:Bind local:Loc.Code128Tip}">
                                                            <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="M1.8,3 h1.3 v10 h-1.3 Z M4,3 h0.7 v10 h-0.7 Z M5.6,3 h1.7 v10 h-1.7 Z M8.2,3 h0.7 v10 h-0.7 Z M9.7,3 h1.3 v10 h-1.3 Z M11.8,3 h0.7 v10 h-0.7 Z M13.2,3 h1 v10 h-1 Z"/>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="12.5" PlaceholderText="{x:Bind local:Loc.TextToEncode}"
                                                             Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             GotFocus="RowText_GotFocus" PreviewKeyDown="RowText_PreviewKeyDown"/>
                                                    <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Padding="6" Margin="4,0,0,0"
                                                            Click="Copy_Click" IsEnabled="{x:Bind CanCopy, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind local:Loc.CopyImage}">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="6"
                                                            Click="Delete_Click" ToolTipService.ToolTip="{x:Bind local:Loc.Delete}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                                <!-- Marques avant/après pendant un glisser -->
                                                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource Accent}" VerticalAlignment="Top"
                                                           Margin="18,-2,4,0" IsHitTestVisible="False" Visibility="{x:Bind DropBefore, Mode=OneWay}"/>
                                                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource Accent}" VerticalAlignment="Bottom"
                                                           Margin="18,0,4,-2" IsHitTestVisible="False" Visibility="{x:Bind DropAfter, Mode=OneWay}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Ligne suivante (aussi par Entrée dans une ligne), de la largeur d'une ligne de code -->
                                <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="AddRow_Click"
                                        Background="Transparent" BorderBrush="{ThemeResource DashStroke}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                            <TextBlock Text="{x:Bind local:Loc.AddRow}"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" BorderBrush="{ThemeResource Field}" BorderThickness="1" CornerRadius="3"
                                                Background="{ThemeResource FieldBg}" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:Loc.EnterKey}" FontSize="11" Foreground="{ThemeResource Muted}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>

                <!-- Poignée pour élargir ou rétrécir la liste (WinUI n'a pas de GridSplitter) -->
                <Border x:Name="SideSplitter" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent"
                        controls:PointerCursor.Shape="SizeWestEast"
                        Visibility="{x:Bind ViewModel.SideOpen, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind local:Loc.ResizeListTip}"
                        PointerEntered="Splitter_PointerEntered" PointerExited="Splitter_PointerExited" PointerPressed="Splitter_PointerPressed"
                        PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased" PointerCaptureLost="Splitter_PointerCaptureLost">
                    <Rectangle x:Name="SplitterLine" Width="2" HorizontalAlignment="Center" Fill="{ThemeResource Accent}" Opacity="0"/>
                </Border>

                <!-- ===================== Zone principale ===================== -->
                <Grid x:Name="ContentLayer" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Zone de saisie -->
                    <Border Margin="20,16,20,6" Padding="12" Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource Line}" BorderThickness="1" CornerRadius="8"
                            Visibility="{x:Bind ViewModel.NotScanMode, Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposerBox" FontSize="14" PlaceholderText="{x:Bind local:Loc.TextToEncode}" VerticalAlignment="Center"
                                     Text="{x:Bind ViewModel.SelectedTab.ComposerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="Composer_PreviewKeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton IsChecked="{x:Bind ViewModel.SelectedTab.ComposerIsQr, Mode=OneWay}" Click="ComposerQr_Click" CornerRadius="4,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="F0 M2,2 H7 V7 H2 Z M3.2,3.2 V5.8 H5.8 V3.2 Z M9,2 H14 V7 H9 Z M10.2,3.2 V5.8 H12.8 V3.2 Z M2,9 H7 V14 H2 Z M3.2,10.2 V12.8 H5.8 V10.2 Z M9,9 H11 V11 H9 Z M12,12 H14 V14 H12 Z M9,12.6 H10.4 V14 H9 Z M12.6,9 H14 V10.4 H12.6 Z"/>
                                        <TextBlock Text="{x:Bind local:Loc.QrCode}"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton IsChecked="{x:Bind ViewModel.SelectedTab.ComposerIsCode128, Mode=OneWay}" Click="ComposerCode128_Click" CornerRadius="0,4,4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="M1.8,3 h1.3 v10 h-1.3 Z M4,3 h0.7 v10 h-0.7 Z M5.6,3 h1.7 v10 h-1.7 Z M8.2,3 h0.7 v10 h-0.7 Z M9.7,3 h1.3 v10 h-1.3 Z M11.8,3 h0.7 v10 h-0.7 Z M13.2,3 h1 v10 h-1 Z"/>
                                        <TextBlock Text="{x:Bind local:Loc.Code128}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind local:Loc.EditingSelected}" Style="{StaticResource MutedText}" FontSize="12"
                                       Visibility="{x:Bind ViewModel.SelectedTab.IsEditing, Mode=OneWay}"/>
                            <Grid Grid.Column="3">
                                <Button Content="{x:Bind local:Loc.Done}" Click="Done_Click" MinWidth="90"
                                        Visibility="{x:Bind ViewModel.SelectedTab.IsEditing, Mode=OneWay}"/>
                                <Button Content="{x:Bind local:Loc.Add}" Click="Add_Click" MinWidth="90" Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.SelectedTab.NotEditing, Mode=OneWay}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Barre du mode scan -->
                    <Border Margin="20,16,20,6" Padding="14,10" Background="{ThemeResource Accent}" CornerRadius="8"
                            Visibility="{x:Bind ViewModel.ScanMode, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{ThemeResource OnAccent}" Text="{x:Bind local:Loc.ScanBanner}"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{ThemeResource OnAccent}" Visibility="{x:Bind ViewModel.HasLastRead, Mode=OneWay}">
                                    <Run Text="{x:Bind local:Loc.ReadByScanner}"/><Run Text="{x:Bind ViewModel.LastRead, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{x:Bind ViewModel.LastReadStatus, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Click="ExitScan_Click" VerticalAlignment="Center" IsTabStop="False"
                                    Background="Transparent" BorderBrush="{ThemeResource OnAccentBorder}" Foreground="{ThemeResource OnAccent}">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <!-- Par thème : résolues dans le thème de la fenêtre, et suivent son changement -->
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="OnAccentHover"/>
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="OnAccentHover"/>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccent"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccent"/>
                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="OnAccentBorder"/>
                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="OnAccentBorder"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="OnAccentHover"/>
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="OnAccentHover"/>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccent"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccent"/>
                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="OnAccentBorder"/>
                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="OnAccentBorder"/>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <TextBlock Text="{x:Bind local:Loc.ExitScan}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Grille des codes. Prend le clavier en mode scan (la douchette « tape » ce qu'elle lit). -->
                    <ScrollViewer x:Name="CodesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,14,4,8" IsTabStop="True" UseSystemFocusVisuals="False" SizeChanged="CodesScroll_SizeChanged">
                        <Grid>
                            <ItemsControl x:Name="CodesGrid" ItemsSource="{x:Bind ViewModel.SelectedTab.Codes, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:CodeItemViewModel">
                                        <Grid Margin="0,0,16,16" VerticalAlignment="Top">
                                            <Border Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource Line}" BorderThickness="1" CornerRadius="8"
                                                    Padding="14,14,14,10" MinWidth="170"
                                                    PointerPressed="Card_PointerPressed" PointerMoved="Drag_PointerMoved" PointerReleased="Drag_PointerReleased"
                                                    PointerCaptureLost="Drag_PointerCaptureLost" DoubleTapped="Card_DoubleTapped">
                                                <StackPanel>
                                                    <!-- Un code doit toujours être affiché en entier pour être lu : trop large, il s'affine
                                                         (pixels entiers) ou laisse place à un message, jamais coupé (CodeBitmaps.ForScreen) -->
                                                    <Grid HorizontalAlignment="Center">
                                                        <Grid Opacity="{x:Bind CodeOpacity, Mode=OneWay}" SizeChanged="CodeVisual_SizeChanged">
                                                            <!-- Le pointeur ne doit pas masquer le code pendant la lecture ; sans code affiché,
                                                                 il reste visible pour cliquer sur « Passer en QR code » -->
                                                            <controls:PixelImage Source="{x:Bind ShownImage, Mode=OneWay}" Visibility="{x:Bind ShowImage, Mode=OneWay}"
                                                                                 HidesPointer="{x:Bind HidesPointer, Mode=OneWay}"/>
                                                            <Grid Width="{x:Bind PlaceholderWidth, Mode=OneWay}" MinHeight="{x:Bind PlaceholderHeight, Mode=OneWay}"
                                                                  Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}">
                                                                <Rectangle Fill="{ThemeResource CardBg}" Stroke="{ThemeResource DashStroke}" StrokeThickness="1.5" StrokeDashArray="3 2" RadiusX="4" RadiusY="4"/>
                                                                <StackPanel VerticalAlignment="Center" Margin="10">
                                                                    <TextBlock Text="{x:Bind PlaceholderMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                                                               Foreground="{ThemeResource Muted}" FontSize="12.5"/>
                                                                    <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="SwitchToQr_Click"
                                                                            Visibility="{x:Bind CanSwitchToQr, Mode=OneWay}">
                                                                        <TextBlock Text="{x:Bind local:Loc.SwitchToQr}" FontWeight="SemiBold" Foreground="{ThemeResource AccentText}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                        <!-- Texte du code flouté, limité à la taille du code (CodeVisual_SizeChanged) : un long texte
                                                             ne doit jamais agrandir la carte, sinon la grille se réorganise selon le code net -->
                                                        <Border Visibility="{x:Bind IsBlurred, Mode=OneWay}" Background="{ThemeResource OverlayBg}" BorderBrush="{ThemeResource OverlayBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="13" TextWrapping="Wrap"
                                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Texte : un clic le copie. Masqué sans changer la taille de la carte quand le code est flouté. -->
                                                    <Button Style="{StaticResource SubtleButtonStyle}" Margin="0,6,0,0" Padding="6,2,6,3" HorizontalAlignment="Center"
                                                            Click="CopyText_Click" ToolTipService.ToolTip="{x:Bind local:Loc.CopyTextTip}" controls:PointerCursor.Shape="Hand"
                                                            Opacity="{x:Bind DetailsOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind NotBlurred, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                                                    </Button>
                                                    <Grid BorderBrush="{ThemeResource CardDivider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0"
                                                          Opacity="{x:Bind DetailsOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind NotBlurred, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource Muted}" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                            <!-- Code en erreur : pas d'image à copier ni à agrandir (un code trop large pour sa carte peut l'être) -->
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="7" Click="Copy_Click" IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="{x:Bind local:Loc.CopyImage}">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                                            </Button>
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="7" Click="Full_Click" IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="{x:Bind local:Loc.FullScreen}">
                                                                <FontIcon Glyph="&#xE740;" FontSize="14"/>
                                                            </Button>
                                                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="7" Click="Delete_Click"
                                                                    ToolTipService.ToolTip="{x:Bind local:Loc.Delete}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{ThemeResource CardBlurBorder}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"
                                                    Visibility="{x:Bind IsBlurred, Mode=OneWay}"/>
                                            <Border BorderBrush="{ThemeResource Accent}" BorderThickness="2" CornerRadius="9" Margin="-1" IsHitTestVisible="False"
                                                    Visibility="{x:Bind ShowRing, Mode=OneWay}"/>
                                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource Accent}" HorizontalAlignment="Left"
                                                       Margin="-10,8,0,8" IsHitTestVisible="False" Visibility="{x:Bind DropBefore, Mode=OneWay}"/>
                                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource Accent}" HorizontalAlignment="Right"
                                                       Margin="0,8,-10,8" IsHitTestVisible="False" Visibility="{x:Bind DropAfter, Mode=OneWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind local:Loc.EmptyTab}" Foreground="{ThemeResource Muted}" FontSize="14" HorizontalAlignment="Center"
                                       Margin="0,40,16,0" Visibility="{x:Bind ViewModel.SelectedTab.IsEmpty, Mode=OneWay}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Plein écran ===================== -->
        <!-- Sous la barre de titre : les boutons Réduire / Agrandir / Fermer restent visibles et utilisables -->
        <Grid x:Name="FullView" Grid.Row="1" Background="{ThemeResource FullBg}" Visibility="Collapsed" SizeChanged="FullView_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:PixelImage x:Name="FullImage" HorizontalAlignment="Center" HidesPointer="True"/>
                <Button Style="{StaticResource SubtleButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Center" Click="CopyFullText_Click"
                        ToolTipService.ToolTip="{x:Bind local:Loc.CopyTextTip}" controls:PointerCursor.Shape="Hand">
                    <TextBlock x:Name="FullText" FontFamily="{StaticResource Mono}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="900"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22" Spacing="10">
                <Button x:Name="FullPrevButton" Content="{x:Bind local:Loc.Previous}" Click="FullPrev_Click"/>
                <TextBlock x:Name="FullCounter" Style="{StaticResource MutedText}" Margin="4,0"/>
                <Button x:Name="FullNextButton" Content="{x:Bind local:Loc.Next}" Click="FullNext_Click"/>
                <Button Content="{x:Bind local:Loc.CloseEsc}" Click="FullClose_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ===================== Message temporaire ===================== -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                Background="{ThemeResource ToastBg}" CornerRadius="6" Padding="14,9" Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.16"/>
            </Border.OpacityTransition>
            <TextBlock x:Name="ToastText" Foreground="{ThemeResource ToastFg}" FontSize="13"/>
        </Border>
    </Grid>
</Window>
