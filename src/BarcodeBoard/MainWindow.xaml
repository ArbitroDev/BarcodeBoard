<Window x:Class="BarcodeBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BarcodeBoard"
        Width="1240" Height="780" MinWidth="760" MinHeight="480"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBg}"
        Icon="Assets/BarcodeBoard.ico"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">

    <!-- Titre : « nom de l'onglet - nom de l'application » (le nom dépend de la langue) -->
    <Window.Title>
        <MultiBinding StringFormat="{}{0} - {1}">
            <Binding Path="SelectedTab.Name"/>
            <Binding Source="{x:Static local:Loc.AppName}"/>
        </MultiBinding>
    </Window.Title>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CloseHoverFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Curseur façon Windows 11 -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="2,0,-6,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SliderTrack}" VerticalAlignment="Center" Margin="2,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="{DynamicResource SliderThumb}" Stroke="{DynamicResource SliderThumbBorder}" StrokeThickness="1"/>
                                                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="12"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="12"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScanBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderBrush="{DynamicResource OnAccentBorder}" BorderThickness="1" CornerRadius="5" Padding="14,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OnAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Texte d'un code : un clic le copie dans le presse-papiers -->
        <Style x:Key="CopyText" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2,6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{x:Static local:Loc.CopyTextTip}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Vignette de thème du volet Paramètres -->
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Width" Value="122"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Field}" BorderThickness="1"
                                CornerRadius="8" Padding="8">
                            <StackPanel>
                                <ContentPresenter/>
                                <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" Margin="0,8,0,1" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FieldBottom}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashedButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Dash" RadiusX="6" RadiusY="6" Stroke="{DynamicResource DashStroke}" StrokeThickness="1" StrokeDashArray="4 3"/>
                            <ContentPresenter Margin="10,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!-- 42 px en fenêtre (espace au-dessus des onglets), 34 px agrandie (onglets collés en haut), comme l'Explorateur -->
            <RowDefinition x:Name="TitleRow" Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Barre de titre et onglets ===================== -->
        <DockPanel x:Name="TabBar" Grid.Row="0">
            <!-- Place réservée aux vrais boutons système quand Mica est actif (Windows 11) -->
            <Border x:Name="NativeCaptionSpace" DockPanel.Dock="Right" Width="140" Visibility="Collapsed"/>
            <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{x:Static local:Loc.Minimize}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoMin}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="{x:Static local:Loc.Maximize}">
                    <Path x:Name="MaxIcon" Style="{StaticResource Icon}" Data="{StaticResource IcoMax}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="{x:Static local:Loc.Close}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoClose}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
            <!-- Paramètres (thème…), juste avant les boutons de la fenêtre, comme le Bloc-notes ou Paint -->
            <!-- Bouton bascule lié au volet : reste sélectionné tant que le volet est ouvert. Pendant l'ouverture,
                 il ne capte pas le clic : celui-ci ferme le volet (clic « à l'extérieur ») sans le rouvrir. -->
            <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource CaptionToggle}" VerticalAlignment="Top"
                          IsChecked="{Binding IsOpen, ElementName=SettingsPopup, Mode=TwoWay}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Not}}"
                          ToolTip="{x:Static local:Loc.SettingsTip}" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Icône « Paramètres » de Windows (police d'icônes du système) -->
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
            </ToggleButton>
            <!-- Volet décalé de 16 px au-delà du bord droit de la roue : son coin arrondi ne touche pas le bouton -->
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                   HorizontalOffset="-358" VerticalOffset="0" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Margin="0,0,16,16" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14,16,16" Width="420" TextElement.Foreground="{DynamicResource TextBrush}"
                        PreviewKeyDown="SettingsPopup_KeyDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Loc.Settings}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static local:Loc.AppTheme}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,12"/>
                        <!-- Les vignettes montrent chaque thème tel qu'il est, quel que soit le thème actif :
                             leurs couleurs fixes sont voulues et ne passent pas par les palettes. -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource ThemeTile}" Tag="{x:Static local:Loc.ThemeSystem}" Click="ThemeSystem_Click">
                                <Grid Height="64">
                                    <Border Background="#F3F3F3" CornerRadius="5">
                                        <Grid>
                                            <Rectangle Width="34" Height="6" RadiusX="3" RadiusY="3" Fill="#005FB8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"/>
                                            <Rectangle Fill="White" RadiusX="4" RadiusY="4" Margin="10,20,10,10"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#202020" CornerRadius="5">
                                        <Border.Clip>
                                            <PathGeometry Figures="M 104,0 L 104,64 L 0,64 Z"/>
                                        </Border.Clip>
                                        <Grid>
                                            <Rectangle Width="34" Height="6" RadiusX="3" RadiusY="3" Fill="#4CC2FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"/>
                                            <Rectangle Fill="#2B2B2B" RadiusX="4" RadiusY="4" Margin="10,20,10,10"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource ThemeTile}" Tag="{x:Static local:Loc.ThemeLight}" Margin="10,0" Click="ThemeLight_Click">
                                <Border Height="64" Background="#F3F3F3" CornerRadius="5">
                                    <Grid>
                                        <Rectangle Width="34" Height="6" RadiusX="3" RadiusY="3" Fill="#005FB8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"/>
                                        <Rectangle Fill="White" RadiusX="4" RadiusY="4" Margin="10,20,10,10"/>
                                    </Grid>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource ThemeTile}" Tag="{x:Static local:Loc.ThemeDark}" Click="ThemeDark_Click">
                                <Border Height="64" Background="#202020" CornerRadius="5">
                                    <Grid>
                                        <Rectangle Width="34" Height="6" RadiusX="3" RadiusY="3" Fill="#4CC2FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"/>
                                        <Rectangle Fill="#2B2B2B" RadiusX="4" RadiusY="4" Margin="10,20,10,10"/>
                                    </Grid>
                                </Border>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- Centrée sur les onglets (34 px en bas de la barre), pas sur toute la hauteur de la barre de titre -->
            <Image x:Name="TitleIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="14,0,10,9" VerticalAlignment="Bottom"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <DockPanel LastChildFill="False" VerticalAlignment="Bottom">
                <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" ItemsSource="{Binding Tabs}" WindowChrome.IsHitTestVisibleInChrome="True"
                              PreviewMouseWheel="TabStrip_MouseWheel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:TabStripPanel Reserve="80"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TabViewModel}">
                            <Grid x:Name="TabRoot" Height="34" Background="Transparent" ToolTip="{Binding ToolTip}"
                                  MouseLeftButtonDown="Tab_MouseDown" MouseMove="Tab_MouseMove" MouseUp="Tab_MouseUp"
                                  LostMouseCapture="Tab_LostMouseCapture"
                                  ContextMenuOpening="Tab_ContextMenuOpening">
                                <!-- Rempli à l'ouverture : nouvelle fenêtre, autres fenêtres, fermer -->
                                <Grid.ContextMenu>
                                    <ContextMenu/>
                                </Grid.ContextMenu>
                                <!-- Onglet actif : fond jusqu'en bas, fondu dans la barre d'outils -->
                                <Border x:Name="TabBd" CornerRadius="7,7,0,0" Background="Transparent"/>
                                <!-- Onglet survolé, comme dans l'Explorateur : il s'arrête 1 px au-dessus de la barre d'outils -->
                                <Border x:Name="HoverBd" CornerRadius="7,7,0,0" Margin="0,0,0,1" Background="Transparent"/>
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TabText" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                    <TextBox x:Name="RenameBox" Style="{StaticResource FieldBox}" Height="24" FontSize="12.5" Padding="4,0"
                                             Visibility="Collapsed" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="6,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsDirty, Converter={StaticResource Vis}}"/>
                                    <Button x:Name="TabClose" Grid.Column="2" Style="{StaticResource SmallIconButton}" Opacity="0"
                                            Click="CloseTab_Click" ToolTip="{x:Static local:Loc.CloseTabTip}">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IcoClose}"/>
                                    </Button>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBd" Property="Background" Value="{DynamicResource Hover}"/>
                                    <Setter TargetName="TabClose" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="HoverBd" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource ChromeLayer}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter TargetName="TabClose" Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter TargetName="TabText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="NewTab_Click" ToolTip="{x:Static local:Loc.NewTabTip}"
                        VerticalAlignment="Center" Margin="4,0,0,2" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoPlus}"/>
                </Button>
                <Button x:Name="TabListButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="TabList_Click"
                        ToolTip="{x:Static local:Loc.AllTabs}" VerticalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevron}"/>
                    <Button.ContextMenu>
                        <ContextMenu/>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </DockPanel>

        <!-- ===================== Corps ===================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre d'outils -->
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8" Background="{DynamicResource ChromeLayer}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Loc.CodeSize}" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,10,1"/>
                        <Slider Style="{StaticResource FluentSlider}" Width="130" VerticalAlignment="Center"
                                Minimum="110" Maximum="280" SmallChange="10" LargeChange="20" IsMoveToPointEnabled="True"
                                Value="{Binding CodeSize}" ToolTip="{x:Static local:Loc.CodeSizeTip}"/>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="12,0,6,0"/>
                        <ToggleButton Style="{StaticResource ScanToggle}" IsChecked="{Binding ScanMode}" ToolTip="{x:Static local:Loc.ScanModeTip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoScan}"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.ScanMode}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SideOpen}" ToolTip="{x:Static local:Loc.ListTip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoSide}"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.List}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="6,0"/>
                        <Button Style="{StaticResource ToolButton}" Click="Open_Click" ToolTip="{x:Static local:Loc.OpenTip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoOpen}"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.Open}"/>
                            </StackPanel>
                        </Button>
                        <!-- Bouton divisé : Enregistrer et sa flèche d'options, surbrillances jointives -->
                        <Button Style="{StaticResource ToolButton}" Click="Save_Click" ToolTip="{x:Static local:Loc.SaveTip}"
                                local:ButtonShape.CornerRadius="5,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoSave}"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.Save}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveMenuButton" Style="{StaticResource IconButton}" Width="22" Height="Auto" Margin="1,0,0,0"
                                local:ButtonShape.CornerRadius="0,5,5,0" Click="SaveMenu_Click" ToolTip="{x:Static local:Loc.SaveMoreTip}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoChevron}"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static local:Loc.SaveAs}" InputGestureText="{x:Static local:Loc.SaveAsShortcut}" Click="SaveAs_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="{Binding SelectedTab.FileStatus}" Foreground="{DynamicResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,1" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideColumn" Width="360" MinWidth="0" MaxWidth="720"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Poignée pour élargir ou rétrécir la liste -->
                <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="6" Margin="-3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Panel.ZIndex="5" Focusable="False"
                              ToolTip="{x:Static local:Loc.ResizeListTip}" DragCompleted="SideSplitter_DragCompleted"
                              Visibility="{Binding SideOpen, Converter={StaticResource Vis}}">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border x:Name="Hit" Background="Transparent" Cursor="SizeWE">
                                <Border x:Name="Line" Width="2" Background="Transparent" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ===================== Liste latérale ===================== -->
                <Border Background="{DynamicResource SideLayer}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                        Visibility="{Binding SideOpen, Converter={StaticResource Vis}}" IsEnabled="{Binding NotScanMode}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTab.CountLabel}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="14,12,14,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,2,8,14" Focusable="False">
                            <StackPanel>
                                <ItemsControl x:Name="SideList" ItemsSource="{Binding SelectedTab.Codes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CodeItemViewModel}">
                                            <Grid Margin="0,1" AllowDrop="True" Background="Transparent"
                                                  DragOver="Row_DragOver" DragLeave="Item_DragLeave" Drop="Item_Drop"
                                                  MouseLeftButtonDown="Row_MouseDown">
                                                <Border x:Name="RowBd" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="0,4,4,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="Transparent" Cursor="SizeAll" ToolTip="{x:Static local:Loc.DragToMove}"
                                                                MouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove">
                                                            <Path Style="{StaticResource IconFill}" Data="{StaticResource IcoGrip}" Fill="{DynamicResource Tertiary}"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="{DynamicResource Field}" BorderThickness="1" CornerRadius="4"
                                                                Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource SegmentBg}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton Style="{StaticResource IconSegment}" IsChecked="{Binding IsQr}" ToolTip="{x:Static local:Loc.QrCode}">
                                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoQr}"/>
                                                                </RadioButton>
                                                                <Rectangle Width="1" Fill="{DynamicResource Field}"/>
                                                                <RadioButton Style="{StaticResource IconSegment}" IsChecked="{Binding IsCode128}" ToolTip="{x:Static local:Loc.Code128Tip}">
                                                                    <Path Style="{StaticResource IconFill}" Data="{StaticResource IcoBar}"/>
                                                                </RadioButton>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" Height="30" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                 Tag="{x:Static local:Loc.TextToEncode}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 GotKeyboardFocus="RowText_GotFocus" PreviewKeyDown="RowText_KeyDown"/>
                                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="4,0,0,0"
                                                                Click="Copy_Click" ToolTip="{x:Static local:Loc.CopyImage}"
                                                                IsEnabled="{Binding ShowPlaceholder, Converter={StaticResource Not}}">
                                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCopy}"/>
                                                        </Button>
                                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                Click="Delete_Click" ToolTip="{x:Static local:Loc.Delete}">
                                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDelete}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" VerticalAlignment="Top"
                                                           Margin="18,-2,4,0" IsHitTestVisible="False"
                                                           Visibility="{Binding DropBefore, Converter={StaticResource Vis}}"/>
                                                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" VerticalAlignment="Bottom"
                                                           Margin="18,0,4,-2" IsHitTestVisible="False"
                                                           Visibility="{Binding DropAfter, Converter={StaticResource Vis}}"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource RowSelectedBorder}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource DashedButton}" Margin="18,6,0,0" Click="AddRow_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Field}" BorderThickness="1" CornerRadius="3"
                                                Background="{DynamicResource FieldBg}" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static local:Loc.EnterKey}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IcoPlus}"/>
                                            <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.AddRow}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===================== Zone principale ===================== -->
                <Grid Grid.Column="2" Background="{DynamicResource ContentLayer}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Zone de saisie -->
                    <Border Margin="20,16,20,6" Padding="12" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding NotScanMode, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border BorderBrush="{DynamicResource Field}" BorderThickness="1" CornerRadius="5" Height="36" Margin="10,0" Background="{DynamicResource SegmentBg}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding SelectedTab.ComposerIsQr}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource IcoQr}"/>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.QrCode}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <Rectangle Width="1" Fill="{DynamicResource Field}"/>
                                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding SelectedTab.ComposerIsCode128}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconFill}" Data="{StaticResource IcoBar}"/>
                                                <TextBlock Style="{StaticResource Lbl}" Text="{x:Static local:Loc.Code128}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Static local:Loc.EditingSelected}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,10,1" Visibility="{Binding SelectedTab.IsEditing, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource SecondaryButton}" Click="Done_Click"
                                        Visibility="{Binding SelectedTab.IsEditing, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{x:Static local:Loc.Done}" Margin="0,0,0,2"/>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Click="Add_Click"
                                        Visibility="{Binding SelectedTab.IsEditing, Converter={StaticResource NotVis}}">
                                    <TextBlock Text="{x:Static local:Loc.Add}" Margin="0,0,0,2"/>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="ComposerBox" Style="{StaticResource FieldBox}" Height="36" FontSize="14" Padding="11,0" Tag="{x:Static local:Loc.TextToEncode}"
                                     Text="{Binding SelectedTab.ComposerText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Composer_KeyDown"/>
                        </DockPanel>
                    </Border>

                    <!-- Barre du mode scan -->
                    <Border Margin="20,16,20,6" Padding="14,10" Background="{DynamicResource Accent}" CornerRadius="8"
                            TextElement.Foreground="{DynamicResource OnAccent}" Visibility="{Binding ScanMode, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ScanBarButton}" Click="ExitScan_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{x:Static local:Loc.ExitScan}" Margin="0,0,0,1"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" TextWrapping="Wrap"
                                           Text="{x:Static local:Loc.ScanBanner}"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding HasLastRead, Converter={StaticResource Vis}}">
                                    <Run Text="{x:Static local:Loc.ReadByScanner}"/><Run Text="{Binding LastRead, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding LastReadStatus, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Grille des codes -->
                    <ScrollViewer x:Name="CodesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,14,4,8" Focusable="True" FocusVisualStyle="{x:Null}" ScrollChanged="CodesScroll_ScrollChanged">
                        <Grid>
                            <ItemsControl x:Name="CodesGrid" ItemsSource="{Binding SelectedTab.Codes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CodeItemViewModel}">
                                        <Grid Margin="0,0,16,16" VerticalAlignment="Top" AllowDrop="True" DragOver="Card_DragOver" DragLeave="Item_DragLeave" Drop="Item_Drop">
                                            <Border x:Name="Card" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                                                    Padding="14,14,14,10" MinWidth="170"
                                                    MouseLeftButtonDown="Card_MouseDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseUp">
                                                <StackPanel>
                                                    <!-- Un code doit toujours être affiché en entier pour être lu : trop large, il s'affine
                                                         (pixels entiers) ou laisse place à un message, jamais coupé (CodeImages.ForScreen) -->
                                                    <Grid HorizontalAlignment="Center">
                                                        <Grid x:Name="CodeVisual">
                                                            <Image Source="{Binding Image}" Stretch="None" SnapsToDevicePixels="True"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource NotVis}}"/>
                                                            <Grid Width="{Binding PlaceholderWidth}" MinHeight="{Binding PlaceholderHeight}"
                                                                  Visibility="{Binding ShowPlaceholder, Converter={StaticResource Vis}}">
                                                                <Rectangle Fill="{DynamicResource CardBg}" Stroke="{DynamicResource DashStroke}" StrokeThickness="1.5" StrokeDashArray="3 2" RadiusX="4" RadiusY="4"/>
                                                                <StackPanel VerticalAlignment="Center" Margin="10">
                                                                    <TextBlock Text="{Binding PlaceholderMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                                                                    <Button Style="{StaticResource ToolButton}" Foreground="{DynamicResource AccentText}" Padding="8,4"
                                                                            HorizontalAlignment="Center" Margin="0,6,0,0" Click="SwitchToQr_Click"
                                                                            Visibility="{Binding CanSwitchToQr, Converter={StaticResource Vis}}">
                                                                        <TextBlock Text="{x:Static local:Loc.SwitchToQr}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                        <!-- Limité à la taille du code : un long texte ne doit jamais agrandir la carte, sinon
                                                             la carte change de taille (et la grille se réorganise) selon qu'elle est nette ou non -->
                                                        <Border x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1"
                                                                CornerRadius="4" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                MaxWidth="{Binding ActualWidth, ElementName=CodeVisual}" MaxHeight="{Binding ActualHeight, ElementName=CodeVisual}">
                                                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </Grid>
                                                    <Border x:Name="CardText" Style="{StaticResource CopyText}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                            MouseLeftButtonUp="CopyText_MouseUp">
                                                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                                                    </Border>
                                                    <Border x:Name="CardActions" BorderBrush="{DynamicResource CardDivider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <!-- Code non affiché (erreur, trop large) : rien à copier ni à agrandir -->
                                                                <Button Style="{StaticResource IconButton}" Click="Copy_Click" ToolTip="{x:Static local:Loc.CopyImage}"
                                                                        IsEnabled="{Binding ShowPlaceholder, Converter={StaticResource Not}}">
                                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoCopy}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource IconButton}" Click="Full_Click" ToolTip="{x:Static local:Loc.FullScreen}"
                                                                        IsEnabled="{Binding ShowPlaceholder, Converter={StaticResource Not}}">
                                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoFull}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource IconButton}" Click="Delete_Click" ToolTip="{x:Static local:Loc.Delete}">
                                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IcoDelete}"/>
                                                                </Button>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,1"/>
                                                        </DockPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SelRing" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" Margin="-1"
                                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" HorizontalAlignment="Left"
                                                       Margin="-10,8,0,8" IsHitTestVisible="False"
                                                       Visibility="{Binding DropBefore, Converter={StaticResource Vis}}"/>
                                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" HorizontalAlignment="Right"
                                                       Margin="0,8,-10,8" IsHitTestVisible="False"
                                                       Visibility="{Binding DropAfter, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelRing" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsScanFocus}" Value="True">
                                                <Setter TargetName="SelRing" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- Le pointeur ne doit pas masquer le code pendant la lecture ; sans code affiché,
                                                 il reste visible pour cliquer sur « Passer en QR code » -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsScanFocus}" Value="True"/>
                                                    <Condition Binding="{Binding ShowPlaceholder}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CodeVisual" Property="Cursor" Value="None"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsBlurred}" Value="True">
                                                <Setter TargetName="CodeVisual" Property="Effect">
                                                    <Setter.Value>
                                                        <BlurEffect Radius="22" KernelType="Gaussian"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="CodeVisual" Property="Opacity" Value="0.25"/>
                                                <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CardText" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="CardActions" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardBlurBorder}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Static local:Loc.EmptyTab}" Foreground="{DynamicResource Muted}" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,40,16,0"
                                       Visibility="{Binding SelectedTab.HasCodes, Converter={StaticResource NotVis}}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Plein écran ===================== -->
        <!-- Sous la barre de titre : les boutons Réduire / Agrandir / Fermer restent visibles et utilisables -->
        <Grid x:Name="FullView" Grid.Row="1" Background="{DynamicResource FullBg}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="FullImage" Stretch="None" SnapsToDevicePixels="True" HorizontalAlignment="Center" Cursor="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Border Style="{StaticResource CopyText}" Margin="0,14,0,0" HorizontalAlignment="Center" MouseLeftButtonUp="CopyFullText_MouseUp">
                    <TextBlock x:Name="FullText" FontFamily="{StaticResource Mono}" FontSize="18"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="900"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                <Button Style="{StaticResource SecondaryButton}" Height="32" FontSize="13" Padding="14,0" Click="FullPrev_Click" x:Name="FullPrevButton">
                    <TextBlock Text="{x:Static local:Loc.Previous}" Margin="0,0,0,2"/>
                </Button>
                <TextBlock x:Name="FullCounter" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,14,1"/>
                <Button Style="{StaticResource SecondaryButton}" Height="32" FontSize="13" Padding="14,0" Click="FullNext_Click" x:Name="FullNextButton">
                    <TextBlock Text="{x:Static local:Loc.Next}" Margin="0,0,0,2"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="32" FontSize="13" Padding="14,0" Margin="10,0,0,0" Click="FullClose_Click">
                    <TextBlock Text="{x:Static local:Loc.CloseEsc}" Margin="0,0,0,2"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Message temporaire ===================== -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                Background="{DynamicResource ToastBg}" CornerRadius="6" Padding="14,9" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastFg}" FontSize="13"/>
        </Border>
    </Grid>
</Window>
