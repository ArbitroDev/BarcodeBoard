    <SolidColorBrush x:Key="SegmentHover" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SegmentDisabledBg" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="SegmentDisabledFg" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="SegmentCheckedDisabledBg" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="SegmentCheckedDisabledFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IconSegmentFg" Color="#555555"/>
