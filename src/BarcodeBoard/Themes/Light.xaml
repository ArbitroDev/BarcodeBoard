<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette du thème clair. Les deux fichiers ont exactement les mêmes clés. -->
    <SolidColorBrush x:Key="WindowBg" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="BodyBg" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Muted" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="Tertiary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E6EEF7"/>
    <SolidColorBrush x:Key="AccentText" Color="#00468A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBorder" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentHover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Field" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="FieldBottom" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="FieldBg" Color="#FDFDFD"/>
    <SolidColorBrush x:Key="FieldBgFocus" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Placeholder" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Hover" Color="#0D000000"/>
    <SolidColorBrush x:Key="Pressed" Color="#17000000"/>
    <SolidColorBrush x:Key="CaptionSelected" Color="#14000000"/>
