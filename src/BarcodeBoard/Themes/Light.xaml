    <SolidColorBrush x:Key="PopupBg" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="PopupBorder" Color="#24000000"/>
    <!-- Survol du bouton Fermer dessiné (Windows 10 ou sans Mica) : le rouge standard de Windows -->
    <SolidColorBrush x:Key="CloseHoverBg" Color="#C42B1C"/>
    <SolidColorBrush x:Key="CloseHoverFg" Color="White"/>
    <SolidColorBrush x:Key="ChromeLayer" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SideLayer" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ContentLayer" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ChromeLayerMica" Color="#CCF9F9F9"/>
    <SolidColorBrush x:Key="SideLayerMica" Color="#80F6F6F6"/>
    <SolidColorBrush x:Key="ContentLayerMica" Color="#E6F9F9F9"/>
</ResourceDictionary>
