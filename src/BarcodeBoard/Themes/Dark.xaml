    <SolidColorBrush x:Key="CloseHoverBg" Color="#C42B1C"/>
    <SolidColorBrush x:Key="CloseHoverFg" Color="White"/>
    <SolidColorBrush x:Key="ChromeLayer" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SideLayer" Color="#242424"/>
    <SolidColorBrush x:Key="ContentLayer" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ChromeLayerMica" Color="#B32B2B2B"/>
    <SolidColorBrush x:Key="SideLayerMica" Color="#4D1C1C1C"/>
