<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette du thème sombre. Les deux fichiers ont exactement les mêmes clés. -->
    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="BodyBg" Color="#202020"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Tertiary" Color="#8A8A8A"/>
